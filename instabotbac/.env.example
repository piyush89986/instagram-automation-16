# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Connection String - Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ig-saas?retryWrites=true&w=majority

# Redis (For BullMQ background job queues - e.g. Upstash, Redis Cloud, or internal service)
REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Security (Generate strong random secrets for production)
JWT_ACCESS_SECRET=generate_a_long_random_string_for_access_secret_here
JWT_REFRESH_SECRET=generate_a_long_random_string_for_refresh_secret_here

# Frontend CORS allowed origins (Comma separated for multiple domains)
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Meta (Instagram Graph API Credentials)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
META_CONFIG_ID=your_meta_configuration_id_here
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token_here

# AI Providers (At least one is required for AI chat / auto-reply features)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
