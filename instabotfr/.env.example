# Backend API URL (Include /api/v1 at the end)
VITE_API_URL=https://your-backend.onrender.com/api/v1

# Backend Socket Server Root URL (Without /api/v1)
VITE_BACKEND_URL=https://your-backend.onrender.com

# Meta App ID (From Facebook Developer Portal)
VITE_META_APP_ID=your_meta_app_id

# Meta Configuration ID for Facebook Login for Business (Optional)
VITE_META_CONFIG_ID=your_meta_config_id
META_CONFIG_ID=your_meta_config_id
